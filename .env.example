# Public mobile configuration only. These values are safe for the client when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional geocoder override. Defaults to the public OpenStreetMap Nominatim endpoint.
# EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org

# Optional: published legal policies. Never place private credentials here.
# EXPO_PUBLIC_TERMS_URL=https://your-domain.example/terms
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy

# Optional legacy native Google Maps configuration. Current maps use a key-free
# OpenStreetMap embed, so this is NOT required for the current app.
# Restrict this key by Android package/SHA-1 and Maps SDK for Android API.
# GOOGLE_MAPS_ANDROID_API_KEY=your_restricted_android_maps_key

# Autocomplete/details now use the authenticated safar-destinations function.
# Configure PHOTON_BASE_URL server-side, never ask users for provider keys.
